{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m cestaplan_api.scripts.sync_all_sources",
    "cronSchedule": "0 4 * * *",
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
