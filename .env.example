# ============================================================
# CestaPlan — example environment. Copy to .env and fill in.
# Never commit a real .env. See docs/SECURITY.md.
# ============================================================

# --- Deployment mode ---
# self_hosted | cloud
DEPLOYMENT_MODE=self_hosted
# platform | byok | disabled
AI_BILLING_MODE=disabled

# --- Database ---
# Single shared Postgres. On Railway this is injected as DATABASE_URL.
DATABASE_URL=postgresql+psycopg://cestaplan:cestaplan@localhost:5432/cestaplan

# --- API / web ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated allowed origins for CORS (restrictive by default).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth / sessions ---
# 32+ byte random secret used to sign/rotate session material.
SESSION_SECRET=change-me-generate-a-long-random-value
SESSION_TTL_HOURS=720
COOKIE_SECURE=false          # true in production (HTTPS)
COOKIE_SAMESITE=lax

# --- OpenAI (only used when AI_BILLING_MODE != disabled) ---
# Model is NOT hardcoded in business logic; configure it here.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Commercial price feed (authorized_partner connector) ---
# OPT-IN. A generic connector to a PAID third-party price API the operator subscribes to
# (RadarSuper / Pepesto / …). CestaPlan only CONSUMES an authorized API with the operator's
# key; it does NOT scrape. Leave BASE_URL/API_KEY/MAPPING empty to keep it disabled.
# Also set DataSource(slug='commercial-feed').is_enabled=true to actually run it.
COMMERCIAL_FEED_BASE_URL=
COMMERCIAL_FEED_API_KEY=
COMMERCIAL_FEED_AUTH_HEADER=Authorization: Bearer
COMMERCIAL_FEED_PRODUCTS_PATH=/products
COMMERCIAL_FEED_PAGINATION=none          # none | page | offset
COMMERCIAL_FEED_PAGE_SIZE=100
COMMERCIAL_FEED_ITEMS_PATH=              # dotted path to the items array ("" = response IS the array)
# JSON map {canonical_field: provider_field}; canonical: barcode, product_ref, product_name,
# brand, amount, currency, unit_price, date, store_ref, category, promo_price, package_*.
COMMERCIAL_FEED_MAPPING=
COMMERCIAL_FEED_SOURCE_NAME=Feed comercial autorizado
COMMERCIAL_FEED_ATTRIBUTION=Precios cedidos por un proveedor comercial autorizado, licenciados por el operador.
COMMERCIAL_FEED_LICENSE_CODE=proprietary

# --- Scraping / price-ingestion HTTP layer (FASE A) ---
# OPT-IN and DISABLED by default. When enabled, CestaPlan only accesses sources on their
# declared legal footing with an HONEST, identifiable User-Agent, respects per-domain rate
# limits, and NEVER evades blocks/CAPTCHA/login. None of these are secrets.
SCRAPING_ENABLED=false
PRICE_SYNC_ENABLED=false
SCRAPING_USER_AGENT=CestaPlanBot/0.0 (+https://github.com/; price-ingestion)
SCRAPING_CONTACT_EMAIL=
SCRAPING_MAX_CONCURRENCY=2          # in-flight requests per domain
SCRAPING_REQUEST_DELAY_MIN_MS=500  # min delay between requests to the same domain
SCRAPING_REQUEST_DELAY_MAX_MS=1500 # max delay (jittered within [min, max])
SCRAPING_TIMEOUT_SECONDS=20
SCRAPING_MAX_RETRIES=3
SCRAPING_MAX_RESPONSE_MB=5          # abort downloads larger than this
RAW_CAPTURE_RETENTION_DAYS=30       # RawCapture.expires_at horizon
STALE_PRICE_HOURS=24
EXPIRED_PRICE_HOURS=48
CONNECTOR_FAILURE_THRESHOLD=5       # consecutive failures before the circuit opens
CONNECTOR_CIRCUIT_OPEN_MINUTES=30   # how long a domain's circuit stays open

# --- Per-connector enable flags (all OFF by default; opt-in per retailer) ---
MERCADONA_CONNECTOR_ENABLED=false
ALCAMPO_CONNECTOR_ENABLED=false
CARREFOUR_CONNECTOR_ENABLED=false
DIA_CONNECTOR_ENABLED=false
LIDL_OFFERS_CONNECTOR_ENABLED=false
ALDI_OFFERS_CONNECTOR_ENABLED=false
DEZA_CONNECTOR_ENABLED=false

# --- External price providers (spec §17) ---
# All OFF by default; secrets stay empty. No provider is an official retailer API.
# See docs/PRICE_PROVIDERS.md and docs/PRICE_DATA_RIGHTS.md.
PRICE_PROVIDERS_ENABLED=false

PARSE_BOT_ENABLED=false
PARSE_BOT_API_KEY=
PARSE_BOT_DIA_ENABLED=false
PARSE_BOT_ALCAMPO_ENABLED=false
PARSE_BOT_DIA_BASE_URL=
PARSE_BOT_ALCAMPO_BASE_URL=
PARSE_BOT_TIMEOUT_SECONDS=30
PARSE_BOT_MAX_RETRIES=3

APIFY_ENABLED=false
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_MERCADONA_ENABLED=false
APIFY_MERCADONA_ACTOR_ID=studio-amba~mercadona-scraper
APIFY_MERCADONA_DEFAULT_POSTAL_CODE=
APIFY_MAX_WAIT_SECONDS=900
APIFY_POLL_INTERVAL_SECONDS=10
APIFY_MAX_RESULTS_PER_RUN=1000
APIFY_MAX_DAILY_RUNS=5
APIFY_MAX_DAILY_COST_EUR=10

OPEN_PRICES_ENABLED=false
OPEN_PRICES_BASE_URL=https://prices.openfoodfacts.org/api/v1

PRICE_STALE_HOURS=48
PRICE_EXPIRED_HOURS=168
PRICE_SYNC_MAX_CONCURRENCY=2

# --- Worker / job queue (Postgres-backed, no Redis in MVP) ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_SECONDS=15

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
