# Variables del frontend (Next.js). Copia a `.env.local` para desarrollo local.
# `.env.local` está en .gitignore; este ejemplo sí se versiona.

# URL base del API que consume el cliente. Se INLINEA en el bundle en tiempo de BUILD.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Upstream server-only al que reenvía el proxy de Next (/api-proxy). OBLIGATORIA en el build de
# producción (NODE_ENV=production): upstream.ts aborta si falta. No es NEXT_PUBLIC (no se expone
# al navegador). En docker-compose = http://api:8000; en Railway = URL interna del servicio api.
API_UPSTREAM_URL=http://localhost:8000
